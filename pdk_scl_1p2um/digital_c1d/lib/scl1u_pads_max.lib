        rise_power(pwr_tin_5) { 
          index_1("1.1, 1.164, 1.391, 1.823, 2.496");
          values("4.888e-17, 4.888e-17, 4.888e-17, 4.888e-17, 4.888e-17");
        }
      }
    }
  }

  /* title : 5V VDD for  I/O Circuitry */
cell (PVDD01) {
	area : 93.96;
	pad_cell : true;
	cell_leakage_power : 0 ;
	pin(PVDD01) {
  		direction : output;
 	 	is_pad : true;
 	     function : "1";
   	}
} /* end of cell */



